    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgentLimitsProbe</AssemblyName>
    <RootNamespace>AgentLimits</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
